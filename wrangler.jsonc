{
  "name": "momsanytime-com",
  "compatibility_date": "2026-08-01",

  // Build the client here rather than relying on the Workers Builds dashboard
  // having a build command configured. The repo was connected to Cloudflare
  // while it still held only a README, so no framework preset was detected and
  // dist/public would otherwise never be produced. Running it twice is a no-op.
  "build": {
    "command": "pnpm build"
  },

  // Custom domains: Cloudflare creates the DNS records and issues the TLS
  // certificates on deploy, so this needs no dashboard DNS work. Both spellings
  // are listed because a custom domain matches its hostname exactly — an apex
  // entry does not cover www. Only production deploys (from the default branch)
  // attach these; a branch preview build will not.
  "routes": [
    { "pattern": "momsanytime.com", "custom_domain": true },
    { "pattern": "www.momsanytime.com", "custom_domain": true }
  ],

  // The site is entirely static, so there is no Worker script: `assets` with no
  // `main` deploys the built client on its own. `server/index.ts` stays for
  // `pnpm start` and Node hosts — Workers cannot run an Express listener.
  "assets": {
    "directory": "./dist/public",
    // wouter routes on the client, so unknown paths must return index.html
    // rather than a 404 page.
    "not_found_handling": "single-page-application"
  }
}
